# Public (safe to expose in the browser bundle)
VITE_SUPABASE_URL=
# New-style publishable key (preferred). Falls back to VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_APP_VERSION=
VITE_META_PIXEL_ID=

# Secrets — set only in Supabase function secrets, never here, never committed:
# SUPABASE_SERVICE_ROLE_KEY
# TELEGRAM_BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET
# TELEGRAM_STAFF_CHAT_ID   (comma-separated chat ids for new-order messages)
# TELEGRAM_STAFF_IDS       (comma-separated user ids allowed to press status buttons)
# TURNSTILE_SECRET
# IP_HASH_SALT
# ALLOWED_ORIGINS          (comma-separated; unset allows any origin in dev)
